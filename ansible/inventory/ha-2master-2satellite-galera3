# Inventory mẫu — 2 master (HA icinga2 zone) + 2 satellite (HA 1 zone con) + 3 node Galera cluster
# THẬT (10.0.0.11-17). Đổi IP theo hạ tầng thật của bạn. Đổi tên từ "ha-2master-standalone-db"
# (2026-07-23, theo yêu cầu người dùng — tên cũ sai/gây nhầm: DB ở đây là Galera cluster THẬT,
# không phải standalone).
# Mô hình multi-master luôn dùng deployment node TÁCH RIÊNG, không nằm trong inventory này.
# Deployment node SSH tới toàn bộ master/satellite/Galera; không host nào dùng connection=local.
# satellite_zones (zone gồm icinga-satellite01+icinga-satellite02) khai trong /etc/icinga-ansible/globals.yml.
# Xem thêm "ha-2master-galera3" (cùng 3 node Galera, KHÔNG có satellite) nếu không cần zone con.

[all_hosts]
icinga-master01    ansible_host=10.0.0.11
icinga-master02    ansible_host=10.0.0.12
icinga-satellite01 ansible_host=10.0.0.13
icinga-satellite02 ansible_host=10.0.0.14
galera01           ansible_host=10.0.0.15
galera02           ansible_host=10.0.0.16
galera03           ansible_host=10.0.0.17

# ===== Vai trò Icinga =====
[master]
icinga-master01
icinga-master02

[satellite]
icinga-satellite01
icinga-satellite02

[client]

# ===== Database — 3 node lẻ -> Galera cluster THẬT (không phải standalone) =====
[galera]
galera01
galera02
galera03

[icinga:children]
master
satellite
