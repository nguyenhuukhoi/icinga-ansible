/* {{ ansible_managed }} — Host/Service cho Icinga2 "client" (command endpoint).
   Chỉ render trên ca_host, sync sang các master khác qua zones.d (design 9.3) — KHÔNG tự copy.
   Dùng check "ssh" (TCP + banner, port 22) thay vì hostalive/ping4 (ICMP): container chạy user
   thường (uid 5665, không phải root) nên không tạo được raw ICMP socket dù đã cấp NET_RAW ở
   docker_container — cap_add chỉ thêm vào bounding set, non-root process cần thêm file capability
   (setcap cap_net_raw+ep) trên chính binary ping mà image không có sẵn (phải build lại image mới
   sửa được, ngoài phạm vi). "ssh" dùng TCP socket thường, không cần quyền đặc biệt. */
{% for h in groups['client'] | default([]) %}
object Host "{{ h }}" {
  import "generic-host"
  address          = "{{ hostvars[h].ansible_host | default(h) }}"
  vars.client_endpoint = "{{ h }}"
  check_command    = "ssh"
  command_endpoint = "{{ h }}"
}

object Service "ssh" {
  import "generic-service"
  host_name        = "{{ h }}"
  check_command    = "ssh"
  command_endpoint = "{{ h }}"
}
{% endfor %}
