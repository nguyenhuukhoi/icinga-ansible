/* {{ ansible_managed }} */
/* Hằng số plugin nền (BẮT BUỘC giữ — conf.d tham chiếu, thiếu là fail validate). */
const PluginDir = "/usr/lib/nagios/plugins"
const ManubulonPluginDir = "/usr/lib/nagios/plugins"
const PluginContribDir = "/usr/lib/nagios/plugins"

/* Script check tuỳ biến người dùng tự thêm (mục 14.3/14.5) — mount RIÊNG, nằm NGOÀI PluginDir
   (không phải "/usr/lib/nagios/plugins/custom-plugins", để tách bạch rõ plugin baked-in-image vs
   script tự viết). Dùng trong CheckCommand: CustomPluginDir + "/<tên_script>". */
const CustomPluginDir = "/usr/lib/nagios/custom-plugins"

const NodeName = "{{ inventory_hostname }}"
const ZoneName = "{{ icinga_master_zone_name if inventory_hostname in groups['master'] else (satellite_zone if inventory_hostname in (groups['satellite'] | default([])) else inventory_hostname) }}"

/* TicketSalt cố định (từ passwords.yml) để master thứ 2 & satellite ký được cert. */
const TicketSalt = {{ (icinga2_ticket_salt if inventory_hostname in groups['master'] else '') | to_json }}
