/* {{ ansible_managed }}
 * NotificationCommand qua Telegram Bot API (curl, xem scripts telegram-*-notification.sh) —
 * role-owned, LUÔN có nội dung thật (khác custom-commands.conf, không phải override rỗng).
 * bot_token/chat_id lấy từ passwords.yml (telegram_bot_token/telegram_chat_id), KHÔNG hardcode
 * trong script — chỉ truyền vào lúc chạy qua "arguments" (giống cách by_ssh_* dùng ssh_user).
 *
 * Gán vào Host/Service thật bằng cách đặt custom var (giống mẫu "mail" trong conf.d/notifications.conf
 * gốc của image, dù file đó hiện KHÔNG được include):
 *   object Host "..." {
 *     vars.notification.telegram = { users = [ "telegram-notify-user" ] }
 *   }
 *
 * QUAN TRỌNG — file này CHỈ ĐƯỢC RENDER Ở zones.d/master/ (xem roles/icinga2/tasks/main.yml, KHÔNG
 * phải conf.d/ hay zones.d/global-templates/) — đây là fix triệt để bug notification gửi trùng cho
 * Host/Service thuộc zone satellite. Xem giải thích đầy đủ (lịch sử 3 hướng thử thất bại + root
 * cause đọc từ source Icinga2 + fix cuối cùng) ở comment "BUG NGHIÊM TRỌNG" ngay tại task render
 * trong main.yml. KHÔNG di chuyển file này sang nơi khác nếu không hiểu rõ hệ quả.
 */

object User "telegram-notify-user" {
  // "User" giả — Icinga2 bắt buộc Notification phải gán users/user_groups mới hợp lệ, nhưng
  // script Telegram KHÔNG đọc thông tin gì từ User này (bot_token/chat_id đã có sẵn trong
  // NotificationCommand), chỉ cần tồn tại để thoả điều kiện.
}

object NotificationCommand "telegram-host-notification" {
  command = [ CustomPluginDir + "/telegram-host-notification.sh" ]
  arguments = {
    "-t" = "$telegram_bot_token$"
    "-c" = "$telegram_chat_id$"
    "-d" = "$icinga.long_date_time$"
    "-l" = "$host.name$"
    "-n" = "$host.display_name$"
    "-o" = "$host.output$"
    "-4" = "$address$"
    "-s" = "$host.state$"
    "-y" = "$notification.type$"
  }
  vars.telegram_bot_token = "{{ telegram_bot_token }}"
  vars.telegram_chat_id   = "{{ telegram_chat_id }}"
}

object NotificationCommand "telegram-service-notification" {
  command = [ CustomPluginDir + "/telegram-service-notification.sh" ]
  arguments = {
    "-t" = "$telegram_bot_token$"
    "-c" = "$telegram_chat_id$"
    "-d" = "$icinga.long_date_time$"
    "-l" = "$host.name$"
    "-n" = "$host.display_name$"
    "-e" = "$service.name$"
    "-E" = "$service.display_name$"
    "-o" = "$service.output$"
    "-4" = "$address$"
    "-s" = "$service.state$"
    "-y" = "$notification.type$"
  }
  vars.telegram_bot_token = "{{ telegram_bot_token }}"
  vars.telegram_chat_id   = "{{ telegram_chat_id }}"
}

/* LƯU Ý (BUG THẬT ĐÃ GẶP 2026-07-23): "import" trong "apply Notification" phải trỏ tới 1 NOTIFICATION
 * TEMPLATE (object khai bằng "template Notification"), KHÔNG phải thẳng "NotificationCommand" —
 * "import "telegram-host-notification"" (object NotificationCommand ở trên) làm icinga2 daemon
 * crash-loop lúc validate config: "Import references unknown template". Dùng "command = "..."" gán
 * thẳng tên NotificationCommand, không qua import/template trung gian — đơn giản hơn, đúng cú pháp.
 */
apply Notification "telegram" to Host {
  command = "telegram-host-notification"
  users = [ "telegram-notify-user" ]
  assign where host.vars.notification.telegram
}

apply Notification "telegram" to Service {
  command = "telegram-service-notification"
  users = [ "telegram-notify-user" ]
  assign where host.vars.notification.telegram
}
