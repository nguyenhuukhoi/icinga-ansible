/* {{ ansible_managed }}
 * CheckCommand SSH ra host ngoài cluster — dùng cho Host/Service trong zone satellite (design.md
 * mục 9.4). Wrap ITL "by_ssh" có sẵn (command_by_ssh.conf trong image) — KHÔNG tự định nghĩa lại
 * check_by_ssh từ đầu. "by_ssh_address" ITL đã tự lấy từ Host.address ($check_address$), không cần
 * set lại ở đây.
 *
 * monitoring-plugins CHÍNH THỨC không có "check_mem" (đã xác nhận, không suy đoán) — by_ssh_mem gọi
 * script check_mem.sh tự đặt tay trên host bị monitor (xem design.md mục 9.4 cho cách cài).
 *
 * Private key: {{ icinga_etc_dir }}/icinga2/ssh/id_monitor trên host này, mount vào container tại
 * /data/etc/icinga2/ssh/id_monitor (ro) — xem task "Đồng bộ SSH key monitor" trong tasks/main.yml.
 *
 * Host-key verification: dùng known_hosts riêng ({{ icinga_etc_dir }}/icinga2/ssh/known_hosts, cùng
 * thư mục sync với private key ở trên, tự tạo bằng `ssh-keyscan`) — KHÔNG StrictHostKeyChecking=no
 * (tắt hẳn xác thực host key là lỗ hổng MITM, không chấp nhận được kể cả trong LAN nội bộ).
 */

object CheckCommand "by_ssh_disk" {
  import "by_ssh"
  vars.by_ssh_logname  = "$ssh_user$"
  vars.by_ssh_identity = "/etc/icinga2/ssh/id_monitor"
  vars.by_ssh_options   = ["UserKnownHostsFile=/etc/icinga2/ssh/known_hosts"]
  vars.by_ssh_command   = "/usr/lib/nagios/plugins/check_disk -w $disk_warn$ -c $disk_crit$ -p $disk_path$"
  vars.ssh_user  = "ubuntu"
  vars.disk_warn = "20%"
  vars.disk_crit = "10%"
  vars.disk_path = "/"
}

object CheckCommand "by_ssh_load" {
  import "by_ssh"
  vars.by_ssh_logname  = "$ssh_user$"
  vars.by_ssh_identity = "/etc/icinga2/ssh/id_monitor"
  vars.by_ssh_options   = ["UserKnownHostsFile=/etc/icinga2/ssh/known_hosts"]
  vars.by_ssh_command   = "/usr/lib/nagios/plugins/check_load -w $load_warn$ -c $load_crit$"
  vars.ssh_user  = "ubuntu"
  vars.load_warn = "5,4,3"
  vars.load_crit = "10,8,6"
}

object CheckCommand "by_ssh_mem" {
  import "by_ssh"
  vars.by_ssh_logname  = "$ssh_user$"
  vars.by_ssh_identity = "/etc/icinga2/ssh/id_monitor"
  vars.by_ssh_options   = ["UserKnownHostsFile=/etc/icinga2/ssh/known_hosts"]
  vars.by_ssh_command   = "/usr/local/bin/check_mem.sh -w $mem_warn$ -c $mem_crit$"
  vars.ssh_user  = "ubuntu"
  vars.mem_warn = "80"
  vars.mem_crit = "90"
}

// by_ssh_systemd: check TỔNG QUÁT trạng thái 1 systemd service trên host ngoài qua SSH (vd service
// OpenStack chạy bằng devstack@<tên>.service) — không viết plugin riêng, "systemctl is-active" đã đủ
// chuẩn Nagios exit-code khi bọc qua && / || (0 = OK, 2 = CRITICAL). "systemd_service" là tên unit
// đầy đủ, khai ở Service.vars khi dùng CheckCommand này (xem zones.d/dc-main/hosts.conf).
object CheckCommand "by_ssh_systemd" {
  import "by_ssh"
  vars.by_ssh_logname  = "$ssh_user$"
  vars.by_ssh_identity = "/etc/icinga2/ssh/id_monitor"
  vars.by_ssh_options   = ["UserKnownHostsFile=/etc/icinga2/ssh/known_hosts"]
  vars.by_ssh_command   = "systemctl is-active --quiet $systemd_service$ && echo \"OK - $systemd_service$ is active\" || (echo \"CRITICAL - $systemd_service$ is not active\"; exit 2)"
  vars.ssh_user  = "ubuntu"
}

// by_ssh_lfmp_*: cpu/memory/disk qua Linuxfabrik monitoring-plugins (https://github.com/Linuxfabrik/
// monitoring-plugins, design.md mục 9.8) — KHÁC hẳn by_ssh_disk/load/mem ở trên (monitoring-plugins
// CHÍNH THỨC/Nagios cổ điển): đây là bộ plugin Python riêng, phải tự cài trên host bị monitor (KHÔNG
// có sẵn trong monitoring-plugins hệ thống), path cài đặt cố định theo installer chính thức của
// Linuxfabrik (repo.linuxfabrik.ch) là "/usr/lib64/nagios/plugins/" trên MỌI distro (kể cả Debian/
// Ubuntu — đã tự xác nhận, không suy đoán).
object CheckCommand "by_ssh_lfmp_cpu" {
  import "by_ssh"
  vars.by_ssh_logname  = "$ssh_user$"
  vars.by_ssh_identity = "/etc/icinga2/ssh/id_monitor"
  vars.by_ssh_options   = ["UserKnownHostsFile=/etc/icinga2/ssh/known_hosts"]
  vars.by_ssh_command   = "/usr/lib64/nagios/plugins/cpu-usage -w $lfmp_cpu_warn$ -c $lfmp_cpu_crit$"
  vars.ssh_user  = "ubuntu"
  vars.lfmp_cpu_warn = "80"
  vars.lfmp_cpu_crit = "90"
}

