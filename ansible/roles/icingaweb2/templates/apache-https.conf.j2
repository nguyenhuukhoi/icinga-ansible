{% if icingaweb2_https_port | int != 443 %}
Listen {{ icingaweb2_https_port }}
{% endif %}

<VirtualHost *:{{ icingaweb2_https_port }}>
    ServerName {{ icingaweb2_https_server_name }}
    SSLEngine on
    SSLCertificateFile /data/etc/icingaweb2/tls/certificate.pem
    SSLCertificateKeyFile /data/etc/icingaweb2/tls/{{ 'certificate.pem' if icingaweb2_https_certificate_file == icingaweb2_https_private_key_file else 'private-key.pem' }}
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</VirtualHost>

{% if icingaweb2_https_redirect_http | bool %}
<VirtualHost *:{{ icingaweb2_http_port }}>
    ServerName {{ icingaweb2_https_server_name }}
    Redirect permanent / https://{{ icingaweb2_https_server_name }}{% if icingaweb2_https_port | int != 443 %}:{{ icingaweb2_https_port }}{% endif %}/
</VirtualHost>
{% endif %}
