; {{ ansible_managed }}
[icingaweb2_db]
type     = "db"
db       = "mysql"
host     = "{{ db_host }}"
port     = "{{ db_port }}"
dbname   = "icingaweb2"
username = "icingaweb2"
password = {{ icingaweb2_db_password | to_json }}
charset  = "utf8mb4"

[icingadb]
type     = "db"
db       = "mysql"
host     = "{{ db_host }}"
port     = "{{ db_port }}"
dbname   = "icingadb"
username = "icingadb"
password = {{ icingadb_db_password | to_json }}
charset  = "utf8mb4"
{% if _director_enabled_here | bool %}

[director_db]
type     = "db"
db       = "mysql"
host     = "{{ db_host }}"
port     = "{{ db_port }}"
dbname   = "director"
username = "director"
password = {{ director_db_password | to_json }}
charset  = "utf8"
{% endif %}
