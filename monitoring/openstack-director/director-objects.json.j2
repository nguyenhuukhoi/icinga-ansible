{
  "hosts": {
{% for host in groups['linuxfabrik_targets'] %}
    {{ host | to_json }}: {
      "object_type": "object",
      "display_name": {{ host | replace('-', ' ') | title | to_json }},
      "address": {{ hostvars[host].ansible_host | default(host) | to_json }},
      "check_command": "icmp",
      "zone": {{ icinga_master_zone_name | to_json }},
      "vars": {
        "openstack_node": true,
        "openstack_role": {{ ('controller' if 'controller' in host else 'compute') | to_json }}
      }
    }{{ ',' if not loop.last else '' }}
{% endfor %}
  },
  "services": {
    "Linux CPU via SSH": {
      "object_type": "apply",
      "check_command": "by_ssh",
      "check_interval": 60,
      "retry_interval": 15,
      "max_check_attempts": 3,
      "assign_filter": "host.vars.openstack_role",
      "vars": {
        "lfmp_cpu_warn": 80,
        "lfmp_cpu_crit": 90,
        "by_ssh_logname": "icinga-monitor",
        "by_ssh_identity": "/data/etc/icinga2/ssh/id_monitor",
        "by_ssh_options": ["BatchMode=yes", "StrictHostKeyChecking=yes", "UserKnownHostsFile=/data/etc/icinga2/ssh/known_hosts"],
        "by_ssh_command": "/usr/lib64/nagios/plugins/cpu-usage -w $lfmp_cpu_warn$ -c $lfmp_cpu_crit$"
      }
    },
    "Linux RAM via SSH": {
      "object_type": "apply",
      "check_command": "by_ssh",
      "check_interval": 60,
      "retry_interval": 15,
      "max_check_attempts": 3,
      "assign_filter": "host.vars.openstack_role",
      "vars": {
        "lfmp_memory_warn": 80,
        "lfmp_memory_crit": 90,
        "by_ssh_logname": "icinga-monitor",
        "by_ssh_identity": "/data/etc/icinga2/ssh/id_monitor",
        "by_ssh_options": ["BatchMode=yes", "StrictHostKeyChecking=yes", "UserKnownHostsFile=/data/etc/icinga2/ssh/known_hosts"],
        "by_ssh_command": "/usr/lib64/nagios/plugins/memory-usage -w $lfmp_memory_warn$ -c $lfmp_memory_crit$"
      }
    },
    "Linux Disk via SSH": {
      "object_type": "apply",
      "check_command": "by_ssh",
      "check_interval": 60,
      "retry_interval": 15,
      "max_check_attempts": 3,
      "assign_filter": "host.vars.openstack_role",
      "vars": {
        "lfmp_disk_warn": 85,
        "lfmp_disk_crit": 95,
        "by_ssh_logname": "icinga-monitor",
        "by_ssh_identity": "/data/etc/icinga2/ssh/id_monitor",
        "by_ssh_options": ["BatchMode=yes", "StrictHostKeyChecking=yes", "UserKnownHostsFile=/data/etc/icinga2/ssh/known_hosts"],
        "by_ssh_command": "/usr/lib64/nagios/plugins/disk-usage -w $lfmp_disk_warn$ -c $lfmp_disk_crit$"
      }
    }
  }
}
