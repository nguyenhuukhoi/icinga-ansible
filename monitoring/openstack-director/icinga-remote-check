#!/usr/bin/env bash
# Forced SSH command for the dedicated, unprivileged monitoring account.
set -euo pipefail
export LC_ALL=C

request=${SSH_ORIGINAL_COMMAND:-}
if [[ $request =~ ^/usr/lib64/nagios/plugins/(cpu-usage|memory-usage|disk-usage)[[:space:]]+-w[[:space:]]+([0-9]{1,3})[[:space:]]+-c[[:space:]]+([0-9]{1,3})$ ]]; then
    plugin=${BASH_REMATCH[1]}
    warn=${BASH_REMATCH[2]}
    crit=${BASH_REMATCH[3]}
    if (( 10#$warn < 1 || 10#$warn >= 10#$crit || 10#$crit > 100 )); then
        echo 'UNKNOWN - invalid thresholds'
        exit 3
    fi
    exec "/usr/lib64/nagios/plugins/$plugin" -w "$warn" -c "$crit"
fi

echo 'UNKNOWN - command is not allowlisted'
exit 3
