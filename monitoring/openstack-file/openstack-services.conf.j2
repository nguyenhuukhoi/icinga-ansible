/* Operator-managed OpenStack control-plane checks.
 * Install this authoritative file only on master[0] under
 * zones.d/<master-zone>; native Icinga cluster sync sends it to the peer.
 */

object CheckCommand "openstack-service" {
  command = [ "/usr/lib/nagios/custom-plugins/check_openstack_service.py" ]
  arguments = {
    "--cloud" = "$openstack_cloud$"
    "--service" = "$openstack_service$"
  }
  timeout = 60s
}

object Host "openstack-api" {
  display_name = "OpenStack API VIP"
  address = {{ openstack_api_address | to_json }}
  check_command = "tcp"
  vars.tcp_port = 5000
}

apply Service "OpenStack Nova Services" {
  check_command = "openstack-service"
  vars.openstack_cloud = "monitoring-nova"
  vars.openstack_service = "nova"
  check_interval = 1m
  retry_interval = 15s
  assign where host.name == "openstack-api"
}

apply Service "OpenStack Cinder Services" {
  check_command = "openstack-service"
  vars.openstack_cloud = "monitoring-cinder"
  vars.openstack_service = "cinder"
  check_interval = 1m
  retry_interval = 15s
  assign where host.name == "openstack-api"
}

apply Service "OpenStack Neutron Agents" {
  check_command = "openstack-service"
  vars.openstack_cloud = "monitoring-neutron"
  vars.openstack_service = "neutron"
  check_interval = 1m
  retry_interval = 15s
  assign where host.name == "openstack-api"
}
