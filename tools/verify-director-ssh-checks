#!/usr/bin/env bash
set -euo pipefail

PASSWORDS_FILE="${1:-/etc/icinga-ansible/passwords.yml}"
HOST_PREFIX="${2:-icinga5-}"
EXPECTED_SERVICES="${3:-15}"
API_PASSWORD="$(awk '
  $1 == "icinga2_director_api_user_password:" {
    value = $0
    sub(/^[^:]*:[[:space:]]*/, "", value)
    sub(/[[:space:]]+#.*$/, "", value)
    gsub(/^"|"$/, "", value)
    print value
  }
' "$PASSWORDS_FILE")"

if [[ -z "$API_PASSWORD" ]]; then
  echo "Không đọc được icinga2_director_api_user_password từ $PASSWORDS_FILE" >&2
  exit 1
fi

API_URL="${ICINGA_API_URL:-https://127.0.0.1:5665/v1}"
SERVICE_FILTER="match(\"${HOST_PREFIX}*\", service.host_name)"

curl --silent --show-error --fail-with-body --insecure \
  --user "director:${API_PASSWORD}" \
  --header 'Accept: application/json' \
  --header 'Content-Type: application/json' \
  --request POST "${API_URL}/actions/reschedule-check" \
  --data "{\"type\":\"Service\",\"filter\":\"${SERVICE_FILTER//\"/\\\"}\",\"force\":true}" \
  >/dev/null

sleep 12

curl --silent --show-error --fail-with-body --insecure \
  --user "director:${API_PASSWORD}" \
  --header 'Accept: application/json' \
  --get "${API_URL}/objects/services" \
  --data-urlencode 'attrs=name' \
  --data-urlencode 'attrs=host_name' \
  --data-urlencode 'attrs=check_command' \
  --data-urlencode 'attrs=state' \
  --data-urlencode 'attrs=last_check_result' \
  | HOST_PREFIX="$HOST_PREFIX" EXPECTED_SERVICES="$EXPECTED_SERVICES" python3 -c '
import json, os, sys
prefix = os.environ["HOST_PREFIX"]
expected = int(os.environ["EXPECTED_SERVICES"])
data = json.load(sys.stdin)
rows = []
for result in data.get("results", []):
    attrs = result.get("attrs", {})
    if not str(attrs.get("host_name", "")).startswith(prefix):
        continue
    last = attrs.get("last_check_result") or {}
    rows.append((
        attrs.get("host_name", "?"), attrs.get("name", "?"),
        attrs.get("check_command", "?"), attrs.get("state", "?"),
        (last.get("output") or "NO CHECK RESULT").splitlines()[0]
    ))
for row in sorted(rows):
    print(" | ".join(map(str, row)))
if len(rows) != expected:
    print(f"Expected {expected} services, got {len(rows)}", file=sys.stderr)
    raise SystemExit(2)
if any(row[3] not in (0, 1, 2) or row[4] == "NO CHECK RESULT" for row in rows):
    raise SystemExit(3)
'
