#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="$ROOT/ansible"
GLOBALS="$ROOT/etc/examples/globals.yml"
PASSWORDS="$ROOT/etc/examples/passwords.yml.example"

if [[ -z "${VIRTUAL_ENV:-}" ]]; then
  echo "Chưa activate venv. Chạy: source /path/to/venv/bin/activate" >&2
  exit 1
fi
ANSIBLE_PLAYBOOK="$(command -v ansible-playbook || true)"
if [[ -z "$ANSIBLE_PLAYBOOK" || "$ANSIBLE_PLAYBOOK" != "$VIRTUAL_ENV/bin/ansible-playbook" ]]; then
  echo "Venv '$VIRTUAL_ENV' chưa có Ansible. Chạy: python -m pip install ansible" >&2
  exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck "$ROOT/tools/icinga-ansible" "$ROOT/tools/validate"
else
  echo "SKIP shellcheck (chưa cài)." >&2
fi

cd "$ANSIBLE_DIR"
for playbook in icinga-ansible.yml playbooks/*.yml; do
  echo "syntax-check: $playbook"
  "$ANSIBLE_PLAYBOOK" -i inventory/all-in-one "$playbook" --syntax-check \
    -e "@$GLOBALS" -e "@$PASSWORDS" -e target_host=localhost
done

echo "Validation OK."
