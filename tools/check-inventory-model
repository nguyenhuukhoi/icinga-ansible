#!/usr/bin/env python3
"""Validate controller/managed-node boundaries in rendered Ansible inventory."""

from __future__ import annotations

import json
import sys


def main() -> int:
    try:
        inventory = json.load(sys.stdin)
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        print(f"Không đọc được kết quả ansible-inventory: {exc}", file=sys.stderr)
        return 2

    hostvars = inventory.get("_meta", {}).get("hostvars", {})
    masters = inventory.get("master", {}).get("hosts", [])
    managed = inventory.get("all_hosts", {}).get("hosts", [])
    errors: list[str] = []

    if len(masters) > 1:
        local_hosts = [
            host
            for host in managed
            if str(hostvars.get(host, {}).get("ansible_connection", "")).lower() == "local"
        ]
        if local_hosts:
            errors.append(
                "inventory multi-master phải dùng deployment node riêng; "
                "xoá ansible_connection=local khỏi: " + ", ".join(local_hosts)
            )

    controller_python_hosts = []
    for host in managed:
        interpreter = str(hostvars.get(host, {}).get("ansible_python_interpreter", ""))
        if interpreter == "/path/to/venv" or interpreter.startswith("/path/to/venv/"):
            controller_python_hosts.append(f"{host}={interpreter}")
    if controller_python_hosts:
        errors.append(
            "/path/to/venv chỉ thuộc deployment node; đặt ansible_python_interpreter=/usr/bin/python3 "
            "cho managed node: " + ", ".join(controller_python_hosts)
        )

    if not errors:
        return 0

    print("Inventory không đúng mô hình deployment:", file=sys.stderr)
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
