#!/usr/bin/env bash
# =============================================================================
# icinga-ansible — CLI wrapper bọc ansible-playbook (phong cách kolla-ansible).
#   Usage: icinga-ansible <command> [-i INVENTORY] [--limit HOSTS] [extra ansible args]
#
# QUAN TRỌNG (giống kolla-ansible): repo/tool và config KHÔNG chung chỗ.
#   - Repo (code này) có thể nằm bất cứ đâu, move/clone lại tuỳ ý.
#   - Config THẬT luôn ở đường dẫn OS cố định /etc/icinga-ansible (globals.yml,
#     passwords.yml) — độc lập với repo, sống sót qua mọi lần move/redeploy code.
#     Override bằng biến môi trường ICINGA_ANSIBLE_CONFIG_DIR nếu cần.
#   - Lần đầu dùng: chạy 'icinga-ansible init-config' để sinh /etc/icinga-ansible
#     từ template trong repo (etc/examples/), rồi 'genpwd' để điền secret ngẫu nhiên.
# =============================================================================
set -euo pipefail

# CẢNH BÁO nếu chạy bằng root (2026-07-23, BUG THẬT đã tự gặp) — KHÔNG chặn cứng (all-in-one 1 host
# với ansible_connection=local vẫn chạy được), chỉ cảnh báo vì đây là lỗi rất dễ mắc và khó hiểu khi
# gặp: nếu inventory có SSH ra host KHÁC, chạy bằng root sẽ dùng nhầm /root/.ssh/ (thường không có
# key/không được authorized trên host đích) thay vì key thật của user thường -> lỗi "unreachable"
# khó debug. Ansible tự "become" (sudo) đúng lúc cần cho từng task rồi — không cần chạy cả lệnh này
# bằng root/sudo.
if [[ "$(id -u)" -eq 0 ]]; then
  echo "!!! CẢNH BÁO: đang chạy icinga-ansible bằng ROOT (hoặc qua sudo)." >&2
  echo "    Nếu inventory có SSH ra host khác, việc này sẽ dùng nhầm key SSH của root" >&2
  echo "    (thường không có/không được authorized) thay vì key của user thường -> 'unreachable'." >&2
  echo "    Ansible tự sudo (become) đúng lúc cần cho từng task rồi — hãy chạy lệnh này bằng" >&2
  echo "    user thường có sudo (không cần mật khẩu), KHÔNG cần 'sudo icinga-ansible ...'." >&2
  echo "" >&2
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"     # thư mục repo (code, di chuyển tự do)
ANSIBLE_DIR="$HERE/ansible"
EXAMPLES_DIR="$HERE/etc/examples"                            # template mặc định, đi kèm repo
ANSIBLE_PLAYBOOK=""
ANSIBLE_INVENTORY=""
VENV_PYTHON=""

CONFIG_DIR="${ICINGA_ANSIBLE_CONFIG_DIR:-/etc/icinga-ansible}"   # config THẬT — cố định, ngoài repo
PLAYBOOK="$ANSIBLE_DIR/icinga-ansible.yml"
GLOBALS="$CONFIG_DIR/globals.yml"
PASSWORDS="$CONFIG_DIR/passwords.yml"
DEPLOY_CONFIG_DIR="$CONFIG_DIR/config"    # override tuỳ biến (giống /etc/kolla/config/<svc>) — mục 4.1 design.md

INVENTORY="$ANSIBLE_DIR/inventory/all-in-one"
EXTRA_ARGS=()
LIMIT=""
USER_TAGS=""        # "-t/--tags" người dùng tự truyền — nếu có thì THAY THẾ tag mặc định, xem parse args
TAG_ARGS=()

# Tag mặc định của subcommand CHỈ áp dụng khi người dùng không tự truyền -t/--tags. Phải tách ra thành
# hàm vì ansible-playbook cộng dồn nhiều --tags (xem giải thích ở nhánh -t trong parse args).
set_default_tags() {   # set_default_tags <tag mặc định>
  if [[ -n "$USER_TAGS" ]]; then
    TAG_ARGS=()
    echo "--tags '$USER_TAGS' (bạn truyền) THAY THẾ tag mặc định '$1' của lệnh '$COMMAND'." >&2
  else
    TAG_ARGS=(--tags "$1")
  fi
}

usage() {
  cat <<EOF
icinga-ansible <command> [options]

Cấu hình (đọc/ghi ở \$CONFIG_DIR, mặc định /etc/icinga-ansible — override bằng
env ICINGA_ANSIBLE_CONFIG_DIR):
  init-config         Tạo \$CONFIG_DIR từ template (etc/examples/), không ghi đè nếu đã có
  genpwd              Sinh passwords.yml với giá trị ngẫu nhiên mạnh (tự init-config nếu chưa có)
  restore-config      Khôi phục \$CONFIG_DIR từ backup-full (--config-backup PATH) — dùng khi dựng
                      lại hạ tầng mới, thay cho init-config+genpwd

Vòng đời (2026-07-22: "deploy" KHÔNG còn tự chạy kèm "bootstrap-servers" nữa — 2 bước TÁCH HẲN.
"bootstrap-servers" chỉ cần chạy 1 lần trên host HOÀN TOÀN MỚI — chưa từng cài Docker/chrony. "destroy"
(2026-07-22, sửa lại) KHÔNG còn xoá cấu trúc thư mục nữa (giữ nguyên, giống
kolla-ansible), nên sau "destroy" chỉ cần "deploy" thẳng, KHÔNG cần "bootstrap-servers" lại):
  bootstrap-servers   Cài Docker, chrony và tạo thư mục — chỉ cần 1 lần trên host mới
  prechecks           Kiểm tra tiền deploy (topology, version, cổng)
  pull                Kéo image về host
  deploy              Triển khai toàn bộ stack (giả định host ĐÃ bootstrap ít nhất 1 lần)
  reconfigure         Render lại config & reload service thay đổi
  upgrade-plan        Dry-run: bảng version CURRENT->TARGET (giống kubeadm upgrade plan)
  upgrade             Nâng cấp rolling (sửa icinga_image_versions trong globals.yml rồi chạy)
  rollback            Quay về version cũ + restore DB pre-upgrade (-e confirm=yes)
  post-deploy         In thông tin truy cập / admin
  check               Health-check cluster + web + DB
  destroy             Gỡ container + dữ liệu, giữ nguyên Docker (có xác nhận, giống kolla-ansible:
                      -e confirm=yes-i-really-really-mean-it)

Node ops (P3+):
  add-node | remove-node        Thêm/xoá satellite; remove-node nhận một hoặc nhiều target
                                (-e target_host=sat01,sat02 để xoá song song)
  add-master | remove-master    Thêm/xoá master

DB ops:
  mariadb-backup      Backup DB (kèm snapshot CA/PKI)
  mariadb-recovery    Khôi phục DB / cụm Galera
  recover-db-only     Sau khi restore bản DB duy nhất còn lại: lấy environment ID cũ từ DB,
                      seed giống nhau lên mọi master và xoá Redis state tạm (-e confirm=yes)

Backup/restore toàn hệ thống (dựng lại hạ tầng mới sau sự cố mất hết — design.md mục 10.6):
  backup-full         Backup config (deployment node) + DB+PKI + icingaweb2 config (mọi master),
                      gom về /var/backups/icinga-ansible-config/ (CỐ Ý ngoài \$CONFIG_DIR — destroy
                      không đụng tới)
  restore-pki         (tuỳ chọn, giữa bootstrap-servers và deploy) Pre-seed CA cũ lên ca_host để
                      giữ nguyên định danh PKI — bỏ qua bước này = deploy tự tạo CA mới hoàn toàn
  restore-web         Khôi phục config Icinga Web riêng của từng master từ backup-full
                      (-e restore_backup_ts=YYYYMMDD-HHMMSS -e confirm=yes), rồi chạy deploy
  # Custom image (design.md mục 9.6): icinga-ansible KHÔNG tự build — tự build/push bằng cách nào
  # cũng được, rồi khai custom_image_registry + custom_image_overrides trong globals.yml.
  # Quy trình đầy đủ: restore-config --config-backup PATH -> bootstrap-servers -> [restore-pki
  # -e pki_backup=PATH -e confirm=yes] -> deploy -> mariadb-recovery -e recovery_mode=restore-backup
  # -e restore_backup_tag=full -e confirm=yes (role tự stage DB từ backup directory trên deployment
  # node nếu artifact không còn trên galera[0])

Options:
  -i, --inventory PATH   inventory (mặc định: all-in-one)
      --limit HOSTS      giới hạn host (ansible --limit)
  -t, --tags TAGS        chạy hẹp theo tag — THAY THẾ tag mặc định của lệnh (không cộng dồn).
                         Tag có sẵn: bootstrap, prechecks, mariadb, redis, icinga2, icingadb,
                         web. Ví dụ chỉ đẩy lại config Icinga 2:
                           icinga-ansible reconfigure -i <inv> -t icinga2
                         Lưu ý: tag hẹp bỏ qua prechecks (gắn tag prechecks/deploy).
      --config-backup PATH   dùng với restore-config
  các tham số khác được chuyển thẳng cho ansible-playbook.
EOF
}

# --- parse args --------------------------------------------------------------
[[ $# -lt 1 ]] && { usage; exit 1; }
COMMAND="$1"; shift
CONFIG_BACKUP=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--inventory)
      [[ $# -ge 2 ]] || { echo "$1 cần một đường dẫn inventory." >&2; exit 2; }
      INVENTORY="$2"; shift 2;;
    --limit)
      [[ $# -ge 2 ]] || { echo "$1 cần danh sách host." >&2; exit 2; }
      LIMIT="$2"; shift 2;;
    # BUG THẬT (2026-10-19, người dùng tự gặp): trước đây "-t/--tags" không được CLI nhận diện nên
    # rơi vào nhánh *) và bị NỐI THÊM vào sau "--tags deploy" mà subcommand luôn chèn. ansible-playbook
    # xử lý nhiều --tags theo kiểu CỘNG DỒN (union), không ghi đè — nên tag hiệu lực thành
    # {deploy, <tag của bạn>}. Vì MỌI role trong chuỗi deploy đều đã gắn tag "deploy", việc thêm tag
    # hẹp hơn KHÔNG loại trừ được gì: "reconfigure -t icinga2" chạy đúng y như "reconfigure" (đã đo:
    # 641 task cả hai trường hợp, trong khi chỉ "--tags icinga2" là 487). Tức tool âm thầm làm việc
    # khác hẳn điều người dùng yêu cầu. Giờ bắt tường minh: tag người dùng truyền vào THAY THẾ tag
    # mặc định của subcommand, và in rõ một dòng cho biết điều đó.
    -t|--tags)
      [[ $# -ge 2 ]] || { echo "$1 cần danh sách tag." >&2; exit 2; }
      USER_TAGS="$2"; EXTRA_ARGS+=("--tags" "$2"); shift 2;;
    --tags=*)
      USER_TAGS="${1#--tags=}"; EXTRA_ARGS+=("$1"); shift;;
    --config-backup)
      [[ $# -ge 2 ]] || { echo "$1 cần đường dẫn file backup." >&2; exit 2; }
      CONFIG_BACKUP="$2"; shift 2;;   # dùng cho "restore-config" — xem bên dưới
    -h|--help)       usage; exit 0;;
    *)               EXTRA_ARGS+=("$1"); shift;;
  esac
done

# Help phải hoạt động ngay cả trên máy chưa init-config. Trước đây "icinga-ansible help" đi qua
# guard globals.yml bên dưới và fail, trong khi "-h/--help" chỉ tình cờ thoát sớm lúc parse args.
[[ "$COMMAND" == "help" ]] && { usage; exit 0; }

# Các lệnh vận hành phải dùng Ansible từ virtual environment do operator chủ động activate.
# Venv nằm trên deployment node và chỉ chứa công cụ điều khiển; nó không phải Python interpreter
# của master/satellite/Galera. Ba lệnh Bash thuần bên dưới không cần Ansible.
require_active_ansible_venv() {
  if [[ -z "${VIRTUAL_ENV:-}" ]]; then
    echo "Chưa activate Python virtual environment cho Ansible." >&2
    echo "Chạy: source /path/to/venv/bin/activate" >&2
    exit 1
  fi

  ANSIBLE_PLAYBOOK="$(command -v ansible-playbook || true)"
  if [[ -z "$ANSIBLE_PLAYBOOK" || "$ANSIBLE_PLAYBOOK" != "$VIRTUAL_ENV/bin/ansible-playbook" ]]; then
    echo "Venv '$VIRTUAL_ENV' chưa có ansible-playbook." >&2
    echo "Chạy trong venv: python -m pip install -U pip && python -m pip install ansible" >&2
    exit 1
  fi

  ANSIBLE_INVENTORY="$VIRTUAL_ENV/bin/ansible-inventory"
  VENV_PYTHON="$VIRTUAL_ENV/bin/python"
  if [[ ! -x "$ANSIBLE_INVENTORY" || ! -x "$VENV_PYTHON" ]]; then
    echo "Venv '$VIRTUAL_ENV' thiếu ansible-inventory hoặc python." >&2
    echo "Chạy lại trong venv: python -m pip install ansible" >&2
    exit 1
  fi
}

case "$COMMAND" in
  init-config|restore-config|genpwd) ;;
  *) require_active_ansible_venv ;;
esac

# inventory tương đối -> tuyệt đối theo THƯ MỤC ĐANG ĐỨNG lúc gọi lệnh (CWD), giống hệt
# kolla-ansible (quickstart chính thức: "cp .../all-in-one ." rồi "kolla-ansible deploy -i
# ./all-in-one" — resolve theo CWD, KHÔNG theo repo root). Đổi lại 2026-07-23 theo yêu cầu người
# dùng ("kg dùng đường dẫn, làm như kolla ansible") — trước đây quy relative path về $HERE (repo
# root) khiến người dùng phải gõ "-i ansible/inventory/<tên>" dù đang đứng ngay chỗ đặt file
# inventory của họ (vd copy ra ~/my-cluster rồi chỉ muốn gõ "-i my-cluster"). Chỉ ảnh hưởng path
# TƯƠNG ĐỐI người dùng tự truyền qua -i — path tuyệt đối giữ nguyên, INVENTORY mặc định
# ($ANSIBLE_DIR/inventory/all-in-one) đã tuyệt đối sẵn nên không đổi hành vi khi không truyền -i.
[[ "$INVENTORY" != /* ]] && INVENTORY="$(pwd)/$INVENTORY"

# Kiểm tra hoàn toàn trên deployment node, trước khi Ansible kết nối hay thay đổi host nào. Điều này
# chặn hai lỗi cấu hình nguy hiểm: multi-master dùng nhầm local connection và managed node dùng
# nhầm Python trong venv của deployment node.
validate_inventory_model() {
  local inventory_json
  if ! inventory_json="$(cd "$ANSIBLE_DIR" && "$ANSIBLE_INVENTORY" \
      -i "$INVENTORY" --playbook-dir "$ANSIBLE_DIR" --list)"; then
    echo "Không phân tích được inventory: $INVENTORY" >&2
    exit 1
  fi
  printf '%s' "$inventory_json" | "$VENV_PYTHON" "$HERE/tools/check-inventory-model"
}

case "$COMMAND" in
  init-config|restore-config|genpwd) ;;
  *) validate_inventory_model ;;
esac

# tạo $CONFIG_DIR từ template nếu chưa có (không ghi đè file đã tồn tại)
init_config() {
  if [[ ! -d "$CONFIG_DIR" ]]; then
    echo "Tạo $CONFIG_DIR (cần sudo vì nằm trong /etc)..."
    sudo install -d -o "$(id -un)" -g "$(id -gn)" -m 0750 "$CONFIG_DIR"
  fi
  if [[ ! -f "$GLOBALS" ]]; then
    cp "$EXAMPLES_DIR/globals.yml" "$GLOBALS"
    echo "Đã tạo $GLOBALS từ template — sửa lại theo nhu cầu."
  fi
  if [[ ! -f "$PASSWORDS" && ! -f "$CONFIG_DIR/passwords.yml.example" ]]; then
    cp "$EXAMPLES_DIR/passwords.yml.example" "$CONFIG_DIR/passwords.yml.example"
  fi
}

[[ "$COMMAND" == "init-config" ]] && { init_config; echo "$CONFIG_DIR sẵn sàng."; exit 0; }

# restore-config: đặc biệt như init-config/genpwd — KHÔNG cần $GLOBALS có sẵn trước, vì mục đích
# CHÍNH LÀ khôi phục $CONFIG_DIR (globals.yml/passwords.yml/mọi override) từ file backup do
# "backup-full" tạo ra (xem playbooks/backup-full.yml) — dùng khi dựng lại hạ tầng mới sau sự cố mất
# hết dữ liệu (2026-07-24, theo yêu cầu người dùng). Thuần bash, không qua Ansible.
[[ "$COMMAND" == "restore-config" ]] && {
  if [[ -z "$CONFIG_BACKUP" ]]; then
    echo "Cần --config-backup <đường dẫn file config-*.tar.gz> (xem 'backup-full')." >&2
    exit 1
  fi
  if [[ ! -f "$CONFIG_BACKUP" ]]; then
    echo "Không tìm thấy file: $CONFIG_BACKUP" >&2
    exit 1
  fi

  CONFIG_DIR_REAL="$(realpath -m -- "$CONFIG_DIR")"
  case "$CONFIG_DIR_REAL" in
    /|/etc|/var|/usr|/home|/root|/opt|/srv)
      echo "Từ chối restore vào đường dẫn nguy hiểm: $CONFIG_DIR_REAL" >&2
      exit 1
      ;;
  esac

  # Validate and fully extract to staging before deleting any current config.
  # This also rejects path traversal and archives with an unexpected layout.
  RESTORE_MEMBERS="$(mktemp)"
  RESTORE_STAGE="$(mktemp -d)"
  trap 'rm -f "$RESTORE_MEMBERS"; sudo rm -rf "$RESTORE_STAGE"' EXIT
  sudo tar -tzf "$CONFIG_BACKUP" | tee "$RESTORE_MEMBERS" >/dev/null
  if grep -Eq '(^|/)\.\.(/|$)|^/' "$RESTORE_MEMBERS"; then
    echo "Backup chứa đường dẫn không an toàn; từ chối restore." >&2
    exit 1
  fi
  if [[ "$(awk -F/ 'NF && $1 != "." {print $1}' "$RESTORE_MEMBERS" | sort -u | wc -l)" -ne 1 ]] ||
     ! grep -Eq '^[^/]+/globals\.yml$' "$RESTORE_MEMBERS"; then
    echo "Backup không có đúng một thư mục gốc chứa globals.yml; từ chối restore." >&2
    exit 1
  fi
  sudo tar -xzf "$CONFIG_BACKUP" -C "$RESTORE_STAGE" --strip-components=1
  sudo test -s "$RESTORE_STAGE/globals.yml" || {
    echo "globals.yml sau khi giải nén bị thiếu/rỗng; config hiện tại chưa bị thay đổi." >&2
    exit 1
  }

  if [[ -d "$CONFIG_DIR_REAL" ]] &&
     [[ -n "$(sudo find "$CONFIG_DIR_REAL" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    echo "!!! $CONFIG_DIR_REAL đã có dữ liệu — restore-config sẽ GHI ĐÈ TOÀN BỘ" >&2
    echo "    (globals.yml, passwords.yml, mọi override) bằng nội dung trong backup." >&2
    if [[ "${CONFIRM:-}" != "yes-i-really-really-mean-it" ]]; then
      echo "    Chạy lại kèm CONFIRM=yes-i-really-really-mean-it để xác nhận, vd:" >&2
      echo "    CONFIRM=yes-i-really-really-mean-it icinga-ansible restore-config --config-backup $CONFIG_BACKUP" >&2
      exit 1
    fi
  fi
  # "--strip-components=1": file backup do "backup-full" tạo (community.general.archive) tự bọc 1
  # lớp thư mục top-level TRÙNG TÊN thư mục cuối cùng của icinga_etc_dir (vd "icinga-ansible/") bên
  # trong tar — không strip sẽ giải nén lệch thành $CONFIG_DIR/icinga-ansible/... thay vì thẳng
  # $CONFIG_DIR/... (bug thật đã gặp 2026-07-24 lúc test drill restore thật).
  sudo install -d -m 0750 "$CONFIG_DIR_REAL"
  sudo find "$CONFIG_DIR_REAL" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  sudo cp -a "$RESTORE_STAGE"/. "$CONFIG_DIR_REAL"/
  sudo chown -R "$(id -un):$(id -gn)" "$CONFIG_DIR_REAL"
  rm -f "$RESTORE_MEMBERS"
  sudo rm -rf "$RESTORE_STAGE"
  trap - EXIT
  echo "Đã restore cấu hình vào $CONFIG_DIR_REAL."
  echo "Tiếp theo: kiểm tra lại $GLOBALS (đổi IP/hostname nếu hạ tầng mới khác hạ tầng cũ), rồi"
  echo "  bootstrap-servers -> (tuỳ chọn) restore-pki -> deploy -> mariadb-recovery -> recover-db-only"
  echo "  -> restore-web -> deploy -> check. Xem QUICKSTART.md mục 7.2 để dùng đúng timestamp/confirm."
  exit 0
}

[[ "$COMMAND" == "genpwd" ]] || {
  # các lệnh khác cần config đã tồn tại — báo lỗi rõ ràng thay vì lỗi Jinja/Ansible khó hiểu
  if [[ ! -f "$GLOBALS" ]]; then
    echo "Chưa có $GLOBALS. Chạy: icinga-ansible init-config" >&2
    exit 1
  fi
}

# vault + secrets nếu có
# BUG THẬT (đọc trước khi bỏ check GLOBALS): trước đây chỉ xét $PASSWORDS có vault hay không, dù
# "-e @$GLOBALS" luôn được truyền VÔ ĐIỀU KIỆN cho mọi subcommand (xem hàm run() dưới). globals.yml
# cũng được coi là "secrets/định danh cụm" (xem header destroy.yml) nên hợp lý nếu người dùng tự
# vault-encrypt riêng globals.yml mà không đụng passwords.yml — trước đây mọi subcommand sẽ vỡ ngay
# vì thiếu --ask-vault-pass, lỗi Ansible khó hiểu ("input is not vault encrypted data" hoặc parse lỗi).
VAULT_ARGS=()
PASSWORD_ARGS=()
if [[ -f "$GLOBALS" ]] && head -1 "$GLOBALS" | grep -qF "\$ANSIBLE_VAULT"; then
  VAULT_ARGS+=("--ask-vault-pass")
fi
if [[ -f "$PASSWORDS" ]]; then
  # Config secrets là baseline; -e người dùng truyền phải nằm SAU để có thể
  # rotate/override theo đúng precedence chuẩn của ansible-playbook.
  PASSWORD_ARGS+=("-e" "@$PASSWORDS")
  if [[ ${#VAULT_ARGS[@]} -eq 0 ]] && head -1 "$PASSWORDS" | grep -qF "\$ANSIBLE_VAULT"; then
    VAULT_ARGS+=("--ask-vault-pass")
  fi
fi
[[ -n "$LIMIT" ]] && EXTRA_ARGS+=("--limit" "$LIMIT")

run() {   # run <ansible extra args...>
  cd "$ANSIBLE_DIR"
  "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$PLAYBOOK" \
    -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" \
    "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "$@" "${EXTRA_ARGS[@]}"
}

case "$COMMAND" in
  bootstrap-servers) set_default_tags bootstrap; run "${TAG_ARGS[@]}" ;;
  prechecks)         set_default_tags prechecks; run "${TAG_ARGS[@]}" ;;
  deploy)            set_default_tags deploy; run "${TAG_ARGS[@]}" ;;
  reconfigure)       set_default_tags deploy; run "${TAG_ARGS[@]}" -e icinga_action=reconfigure ;;
  pull)
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/pull.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  post-deploy)
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/post-deploy.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  check)
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/check.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  destroy)
    # KHÔNG dùng run() ở đây: run() luôn chèn $PLAYBOOK (icinga-ansible.yml) mặc định,
    # nếu gộp chung sẽ chạy CẢ deploy lẫn destroy trong 1 lệnh. destroy chạy playbook riêng.
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/destroy.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;

  upgrade-plan)
    # Dry-run, read-only. Playbook riêng (không phải $PLAYBOOK site).
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/upgrade-plan.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  upgrade)
    # Nâng cấp rolling theo icinga_image_versions MỚI trong globals.yml (tự backup pre-upgrade).
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/upgrade.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  rollback)
    # Quay về version CŨ (sửa globals.yml về cũ trước) + restore DB pre-upgrade. Bắt buộc -e confirm=yes.
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/rollback.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;

  add-master|add-node)
    # Thêm host: host đã có trong inventory (nhóm [master] hoặc [satellite]) rồi chạy lại deploy —
    # role đã idempotent, tự nhận ra host chưa có cert/container và tự enroll, đồng thời tự render
    # lại + reload zones.conf trên các host CŨ để chúng biết endpoint mới (đã verify hành vi này
    # thật với master2/sat01/sat02 — không cần playbook riêng).
    # LƯU Ý (2026-07-22, "deploy" không còn tự bootstrap): nếu host MỚI THÊM chưa từng chạy
    # bootstrap-servers (chưa có Docker/chrony/mạng), phải tự chạy "bootstrap-servers" TRƯỚC lệnh
    # này (trước đây "deploy" tự lo hộ, giờ tách hẳn — xem usage()).
    set_default_tags deploy; run "${TAG_ARGS[@]}"
    ;;
  remove-master|remove-node)
    # KHÔNG dùng run(): playbook riêng, không phải $PLAYBOOK mặc định.
    # Bắt buộc: -e target_host=<tên trong inventory> -e confirm=yes
    cd "$ANSIBLE_DIR"
    PB="remove-master.yml"; [[ "$COMMAND" == "remove-node" ]] && PB="remove-node.yml"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/$PB" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    echo ""
    echo "!!! Nhớ: xoá host khỏi inventory rồi chạy 'icinga-ansible reconfigure' để đồng bộ"
    echo "    zones.conf trên các host còn lại (xem thông báo cuối playbook ở trên)."
    ;;
  mariadb-backup)    set_default_tags mariadb; run "${TAG_ARGS[@]}" -e icinga_action=backup ;;
  mariadb-recovery)
    # KHÔNG dùng run(): playbook riêng, không phải $PLAYBOOK mặc định. Bắt buộc:
    # -e recovery_mode=restore-backup|recover-cluster -e confirm=yes (xem design.md 10.4).
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/mariadb-recovery.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  recover-db-only)
    # Chạy SAU mariadb-recovery restore-backup khi chỉ còn DB backup, không còn CA/PKI/runtime
    # của master cũ. Playbook dừng publisher/consumer, lấy environment ID từ DB đã restore,
    # seed cùng ID lên mọi master, FLUSHALL Redis tạm rồi khởi động lại theo đúng thứ tự.
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/recover-db-only.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  restore-web)
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/restore-web.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "deploy_config_dir=$DEPLOY_CONFIG_DIR" \
      "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;

  backup-full)
    # KHÔNG dùng run(): playbook riêng (không phải $PLAYBOOK site). Kết quả gom về
    # icinga_config_backup_dir (mặc định /var/backups/icinga-ansible-config/, CỐ Ý ngoài $CONFIG_DIR
    # — xem group_vars/all.yml, "destroy" chỉ xoá nội dung $CONFIG_DIR nên không bao giờ đụng tới đây)
    # (config+icingaweb2) và mariadb_backup.destination trên node DB chính (DB+PKI) — xem design.md
    # mục 10.6, playbooks/backup-full.yml.
    # icinga_action + backup_tag truyền tường minh để role chỉ chạy nhánh backup.
    cd "$ANSIBLE_DIR"
    BACKUP_TS="$(date +%Y%m%d-%H%M%S)"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/backup-full.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" -e "backup_ts=$BACKUP_TS" -e icinga_action=backup -e backup_tag=full \
      "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;
  restore-pki)
    # KHÔNG dùng run(): playbook riêng. Bắt buộc -e pki_backup=<path pki-*.tar.gz đã copy lên
    # ca_host> -e confirm=yes. Chạy SAU "bootstrap-servers", TRƯỚC "deploy" lần đầu trên hạ tầng
    # MỚI — xem design.md mục 10.6, playbooks/restore-pki.yml. Bỏ qua bước này = PKI mới hoàn toàn
    # (mặc định, "deploy" tự tạo CA mới như bình thường).
    cd "$ANSIBLE_DIR"
    "$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$ANSIBLE_DIR/playbooks/restore-pki.yml" \
      -e "@$GLOBALS" -e "controller_config_dir=$CONFIG_DIR" "${VAULT_ARGS[@]}" "${PASSWORD_ARGS[@]}" "${EXTRA_ARGS[@]}"
    ;;

  genpwd)
    init_config
    if [[ -f "$PASSWORDS" ]]; then
      echo "$PASSWORDS đã tồn tại — không ghi đè."; exit 1
    fi
    cp "$CONFIG_DIR/passwords.yml.example" "$PASSWORDS"
    # thay mọi CHANGE_ME bằng chuỗi ngẫu nhiên 32 ký tự
    while grep -q 'CHANGE_ME' "$PASSWORDS"; do
      RAND="$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | cut -c1-32)"
      sed -i "0,/CHANGE_ME/s//$RAND/" "$PASSWORDS"
    done
    chmod 0600 "$PASSWORDS"
    echo "Đã sinh $PASSWORDS. Mã hoá bằng: ansible-vault encrypt $PASSWORDS"
    ;;

  -h|--help|help)    usage ;;
  *) echo "Lệnh không hợp lệ: $COMMAND"; usage; exit 1 ;;
esac
