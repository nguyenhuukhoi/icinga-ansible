# =============================================================================
# passwords.yml.example — TEMPLATE mặc định. KHÔNG sửa file này, KHÔNG điền secret ở đây.
# CLI ('icinga-ansible init-config' / 'genpwd') copy file này thành
# /etc/icinga-ansible/passwords.yml (đường dẫn OS cố định, ngoài repo) rồi sinh giá trị
# ngẫu nhiên thay CHANGE_ME và ép quyền file 0600. Khuyến nghị mã hoá sau khi sinh:
#     ansible-vault encrypt /etc/icinga-ansible/passwords.yml
# =============================================================================

# MariaDB
mariadb_root_password:        "CHANGE_ME"
icingadb_db_password:         "CHANGE_ME"        # user 'icingadb'
icingaweb2_db_password:       "CHANGE_ME"        # user 'icingaweb2'
director_db_password:         "CHANGE_ME"        # user 'director' (module loại C)

# Redis (icingadb-redis)
icingadb_redis_password:      "CHANGE_ME"

# Icinga 2 cluster
icinga2_ticket_salt:          "CHANGE_ME"        # TicketSalt cho PKI
icinga2_api_user_password:    "CHANGE_ME"        # API user icingaweb2 dùng để deploy config
icinga2_director_api_user_password: "CHANGE_ME"  # ApiUser "director" riêng — theo khuyến nghị chính
                                                  # thức Icinga Director (docs Getting-started: ApiUser
                                                  # tên "director" tách biệt), dùng khi khai Kickstart
                                                  # trong module Director (Configuration > Kickstart wizard)
icingadb_web_api_user_password: "CHANGE_ME"      # ApiUser "icingadb-web" riêng, quyền hạn chế
                                                  # (actions/*, objects/query/*, objects/modify/*,
                                                  # status/query — KHÔNG full "*") — Command Transport
                                                  # cho nút Acknowledge/Downtime/Reschedule trên
                                                  # dashboard Icinga DB Web, tự render vào
                                                  # modules/icingadb/commandtransports.ini

# Icinga Web 2
icingaweb2_admin_user:        "admin"
icingaweb2_admin_password:    "CHANGE_ME"

# Notification qua Telegram (roles/icinga2 — conf.d/telegram-notifications.conf)
# Để trống ("") nếu không dùng — NotificationCommand vẫn render nhưng không có Host/Service nào
# gán vào thì không có gì gửi đi. Lấy token từ @BotFather, chat_id từ getUpdates hoặc bot khác.
telegram_bot_token:           "CHANGE_ME"
telegram_chat_id:             "CHANGE_ME"
